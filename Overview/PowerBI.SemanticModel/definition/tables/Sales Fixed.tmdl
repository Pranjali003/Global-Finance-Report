		displayFolder: 01 | Order Intake
		lineageTag: 2ba70093-82eb-48d5-b4ec-d188d5865caf

	/// Average Order Intake Target GM%
	measure 'OI Target GM%' = AVERAGE('Sales Fixed'[Order Intake Target GM%])
