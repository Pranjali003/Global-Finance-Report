	/// Total Order Intake Target Volume across all product groups
	measure 'Total OI Target Volume' = SUM('Sales Fixed'[Order Intake Target volume])
		formatString: #,0
		displayFolder: 01 | Order Intake
		lineageTag: c2175133-d3e3-4831-bda1-fe79fc5427ca

	/// Total Revenue Target 24/25
	measure 'Total Revenue Target' = SUM('Sales Fixed'[Revenue target 24/25])
